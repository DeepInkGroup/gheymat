# Optional: baha24.com API Bearer token (paid tier — higher rate limits).
# Without it, the app still works using baha24's free/unauthenticated tier
# (rate-limited to 20 requests per window), cached server-side.
BAHA24_API_TOKEN=

# Optional: price history. Without this, the app still works fine — the
# "History" view on each card just shows "not enough data yet" forever.
# History is stored as plain JSON files in data/Database*.json, committed
# straight to this repo by the daily cron job (Vercel's serverless
# filesystem doesn't persist writes, so a real git commit is what makes
# this durable). Needs a GitHub token with contents read/write on this
# repo — a fine-grained PAT scoped to just this repo is recommended over
# a classic PAT with broad access:
# https://github.com/settings/personal-access-tokens/new
GH_COMMIT_TOKEN=

# Only needed if this repo isn't DeepInkGroup/Gheymat on branch "main".
GH_REPO_OWNER=
GH_REPO_NAME=
GH_REPO_BRANCH=

# Optional but recommended once history is set up: protects the cron
# snapshot endpoint from being triggered by random requests. Any random
# string works — set the same value in Vercel's cron job settings.
CRON_SECRET=

# Optional: Energy & Commodities category (WTI, Brent, natural gas, diesel,
# heating oil, jet fuel, gasoline, coal) via oilpriceapi.com. Without it,
# the app still works fine — that category is just always empty/hidden.
# Get a key at https://docs.oilpriceapi.com/. There's no batch endpoint,
# so all 8 codes are fetched individually every ~40 min server-side
# (cached) — keep that cache TTL (in src/lib/oilApi.ts) in sync with
# whatever your plan's actual monthly request quota is.
OILPRICEAPI_KEY=

# Optional: Gold Purity category (24k/22k/21k/18k/14k/12k/9k per gram,
# plus ounce and pound) via the "real-time-metal-prices" RapidAPI. Without
# it, that category is just always empty/hidden. One request returns every
# rate, cached ~2h server-side to stay under a 500 requests/month plan —
# adjust the cache TTL in src/lib/rapidGoldApi.ts if your plan differs.
RAPIDAPI_METAL_KEY=
